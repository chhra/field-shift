# Earth Engine (optional — demos work without these; live Analyze needs them)
EE_SERVICE_ACCOUNT=
# Path to service-account JSON OR raw JSON string
EE_PRIVATE_KEY_JSON=
EE_PROJECT=

# Web ↔ API (local defaults work out of the box)
# FIELD_SHIFT_API_URL=http://127.0.0.1:8000
# FIELD_SHIFT_WEB_ORIGINS=http://localhost:3000
#
# Production (Vercel + Render):
# FIELD_SHIFT_API_URL=https://field-shift-api.onrender.com
# FIELD_SHIFT_WEB_ORIGINS=https://your-app.vercel.app

# Optional US module (Phase 7)
NASS_API_KEY=
AMS_API_KEY=

# Optional LLM rephrase (default off)
LLM_EXPLAIN=false
OPENAI_API_KEY=

TIMELAPSE_URL_TTL_SECONDS=3600
